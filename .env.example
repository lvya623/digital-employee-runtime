# 复制为 .env 后按需修改；不带 .env 也能用 SQLite + MockLLM 完整跑通
DER_LLM_PROVIDER=mock
# DER_LLM_PROVIDER=openai_compat
# DER_LLM_BASE_URL=https://api.openai.com/v1
# DER_LLM_API_KEY=
# DER_LLM_MODEL=gpt-4o-mini
DATABASE_URL=sqlite:///./der.db
# DATABASE_URL=postgresql+psycopg2://der:der_dev@localhost:5432/der
DER_CONTEXT_BUDGET=2048
DER_MAX_RETRIES=2
DER_MAX_REACT_STEPS=12
